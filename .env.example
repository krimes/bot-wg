# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456:AAA-replace-me

# Список Telegram-ID администраторов через запятую.
# Узнать свой ID: напишите боту @userinfobot
ADMIN_IDS=111111111,222222222

# Главный админ: пользователи бота + глобальная рассылка.
# Если пусто — берётся первый ID из ADMIN_IDS.
MAIN_ADMIN_ID=111111111

# Веб-выдача первого WG-конфига (пароль только админам).
# Пусто — сайт не поднимается.
WEB_PASSWORD=
WEB_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- AmneziaWG (Docker) ---
# Имя контейнера, в котором крутится AmneziaWG
AWG_CONTAINER=amnezia-awg

# Имя интерфейса внутри контейнера
AWG_INTERFACE=wg0

# Путь к конфигу сервера внутри контейнера
AWG_CONFIG_PATH=/opt/amnezia/awg/wg0.conf

# Путь к clientsTable — список клиентов, который читает GUI AmneziaVPN.
# Если оставить пустым, бот не будет синхронизировать список с GUI.
AWG_CLIENTS_TABLE_PATH=/opt/amnezia/awg/clientsTable

# Публичный endpoint (host:port), который попадёт в клиентский конфиг.
# Можно указать FQDN или IP, порт берётся из ListenPort сервера если оставить пустым.
AWG_ENDPOINT_HOST=vpn.example.com
AWG_ENDPOINT_PORT=51820

# Подсеть для клиентов (откуда выделяются IP). Должна совпадать с серверной.
AWG_CLIENT_SUBNET=10.8.1.0/24

# DNS для клиентов
AWG_CLIENT_DNS=1.1.1.1,1.0.0.1

# AllowedIPs у клиента: 0.0.0.0/0,::/0 — заворачиваем весь трафик
AWG_CLIENT_ALLOWED_IPS=0.0.0.0/0,::/0

# Keep-alive в секундах (0 — не использовать)
AWG_CLIENT_KEEPALIVE=25

# MTU клиентского туннеля. 1280 — рекомендация AmneziaWG 3.1.
# 0 — не писать строку MTU в .conf (клиент возьмёт свой дефолт).
AWG_CLIENT_MTU=1280

# --- Bot data ---
DB_PATH=/var/lib/awg-bot/awg-bot.db

# --- Кнопка-ссылка в главном меню (опционально) ---
# Если LINK_URL пуст — кнопка не показывается.
LINK_URL=https://amnezia.org/downloads
LINK_BUTTON_TEXT=📥 Скачать AmneziaVPN

# --- 3X-UI / Happ ---
# Если XUI_HOST пуст — Happ-кнопки отвечают «панель не настроена», WG работает как раньше.
# Из Docker-контейнера бота панель на хосте: http://host.docker.internal:ПОРТ
XUI_HOST=
# Секретный путь панели, без ведущего слэша тоже ок (как в настройках 3X-UI)
XUI_WEB_BASE_PATH=
# Логин панели ИЛИ API-токен (Settings → Security → API Token) — токен предпочтительнее
XUI_USERNAME=
XUI_PASSWORD=
XUI_API_TOKEN=
# ID inbound VLESS+Reality (в панели: Inbounds → колонка ID)
XUI_INBOUND_ID=
# Хост, который попадёт в vless:// (публичный IP/домен). Пусто = AWG_ENDPOINT_HOST
XUI_CLIENT_HOST=
# База подписки, без subId: https://vpn.example.com:2096/sub
XUI_SUB_BASE=
# false, если у панели самоподписанный сертификат
XUI_TLS_VERIFY=true
